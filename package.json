    "whiteboard",
    "eraser",
    "vector-eraser",
    "pixel-eraser",
    "canvas",
    "drawing",
    "react"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "tldraw": ">=5.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tldraw": ">=5.0.0",
    "typescript": "^5.6.3"
  }
}
